+Bytes InferenceServer::compute_inner_product(const Bytes& left_bytes,
+                                             const Bytes& right_bytes,
+                                             int embedding_dim) const {
+    if (context_ptr_ == nullptr) {
+        throw std::runtime_error("Evaluation context is not initialized");
+    }
+    Feature0DEncrypted left(context_ptr_, 0);
+    Feature0DEncrypted right(context_ptr_, 0);
+    left.deserialize(left_bytes);
+    right.deserialize(right_bytes);
+    if (embedding_dim <= 0 || left.n_channel != (uint32_t)embedding_dim ||
+        right.n_channel != (uint32_t)embedding_dim) {
+        throw std::runtime_error("Unexpected encrypted embedding dimension");
+    }
+    if (left.data.size() != right.data.size() || left.data.empty() ||
+        left.skip != right.skip || left.n_channel_per_ct != right.n_channel_per_ct) {
+        throw std::runtime_error("Encrypted embedding layouts do not match");
+    }
+
+    auto& ctx = *context_ptr_;
+    const double scale = ctx.get_parameter().get_default_scale();
+    std::vector<ls::CkksCiphertext> partial_sums;
+    partial_sums.reserve(left.data.size());
+    for (size_t index = 0; index < left.data.size(); ++index) {
+        auto product = ctx.rescale(
+            ctx.relinearize(ctx.mult(left.data[index], right.data[index])), scale);
+        auto partial = product.copy();
+        for (uint32_t offset = 1; offset < left.n_channel_per_ct; offset <<= 1) {
+            auto rotated = ctx.rotate(partial, (int)(offset * left.skip));
+            partial = ctx.add(partial, rotated);
+        }
+        partial_sums.push_back(std::move(partial));
+    }
+    auto score = partial_sums.front().copy();
+    for (size_t index = 1; index < partial_sums.size(); ++index) {
+        auto term = partial_sums[index].copy();
+        while (score.get_level() > term.get_level()) score = ctx.drop_level(score);
+        while (term.get_level() > score.get_level()) term = ctx.drop_level(term);
+        score = ctx.add(score, term);
+    }
+
+    Feature0DEncrypted output(context_ptr_, score.get_level());
+    output.n_channel = 1;
+    output.n_channel_per_ct = 1;
+    output.skip = left.skip;
+    output.ckks_scale = scale;
+    output.data.push_back(std::move(score));
+    return output.serialize();
+}
