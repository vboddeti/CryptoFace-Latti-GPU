+void InferenceClient::setup_from_secret_context(const Bytes& secret_context) {
+    read_configuration();
+    if (needs_btp_) {
+        btp_context_ = std::make_unique<CkksBtpContext>(
+            CkksBtpContext::deserialize(secret_context));
+        context_ptr_ = btp_context_.get();
+    } else {
+        ckks_context_ = std::make_unique<CkksContext>(
+            CkksContext::deserialize_advanced(secret_context));
+        context_ptr_ = ckks_context_.get();
+    }
+}
+
+Bytes InferenceClient::export_secret_context() const {
+    if (needs_btp_) {
+        if (!btp_context_) throw std::runtime_error("BTP client context is not initialized");
+        return btp_context_->serialize();
+    }
+    if (!ckks_context_) throw std::runtime_error("CKKS client context is not initialized");
+    return ckks_context_->serialize_advanced();
+}
