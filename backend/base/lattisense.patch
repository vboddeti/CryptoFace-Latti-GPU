+void MegaAG::coalesce_gpu_rotation_siblings() {
+    std::unordered_map<NodeIndex, std::vector<NodeIndex>> rotations_by_source;
+    for (const auto& [compute_index, compute_node] : computes) {
+        if (compute_node.on_cpu || !compute_node.fhe_prop.has_value() ||
+            compute_node.fhe_prop->op_type != OperationType::ROTATE_COL ||
+            !compute_node.fhe_prop->p.has_value() ||
+            compute_node.input_nodes.size() != 2 ||
+            compute_node.output_nodes.size() != 1) {
+            continue;
+        }
+        rotations_by_source[compute_node.input_nodes[0]->index].push_back(compute_index);
+    }
+
+    std::vector<NodeIndex> computes_to_erase;
+    std::size_t batch_count = 0;
+    std::size_t grouped_rotation_count = 0;
+
+    for (auto& [source_index, compute_indices] : rotations_by_source) {
+        if (compute_indices.size() < 2) {
+            continue;
+        }
+        std::sort(compute_indices.begin(), compute_indices.end());
+
+        std::unordered_set<int32_t> unique_steps;
+        std::unordered_set<NodeIndex> unique_keys;
+        std::unordered_set<NodeIndex> unique_outputs;
+        bool compatible = true;
+        for (NodeIndex compute_index : compute_indices) {
+            const ComputeNode& node = computes.at(compute_index);
+            compatible =
+                compatible &&
+                unique_steps.insert(node.fhe_prop->p->rotation_step).second &&
+                unique_keys.insert(node.input_nodes[1]->index).second &&
+                unique_outputs.insert(node.output_nodes[0]->index).second;
+        }
+        if (!compatible) {
+            continue;
+        }
+
+        ComputeNode& batch = computes.at(compute_indices.front());
+        DatumNode* shared_input = batch.input_nodes[0];
+        std::vector<DatumNode*> batch_inputs{shared_input};
+        std::vector<DatumNode*> batch_outputs;
+        std::vector<int32_t> batch_steps;
+        batch_inputs.reserve(compute_indices.size() + 1);
+        batch_outputs.reserve(compute_indices.size());
+        batch_steps.reserve(compute_indices.size());
+
+        for (NodeIndex compute_index : compute_indices) {
+            const ComputeNode& node = computes.at(compute_index);
+            batch_inputs.push_back(node.input_nodes[1]);
+            batch_outputs.push_back(node.output_nodes[0]);
+            batch_steps.push_back(node.fhe_prop->p->rotation_step);
+        }
+
+        batch.input_nodes = std::move(batch_inputs);
+        batch.output_nodes = std::move(batch_outputs);
+        batch.fhe_prop->p->rotation_steps = std::move(batch_steps);
+        batch.id += "_hoisted_" + std::to_string(compute_indices.size());
+        ExecutorBinder::bind_executor(batch, Processor::GPU, algo);
+
+        computes_to_erase.insert(computes_to_erase.end(),
+                                 compute_indices.begin() + 1,
+                                 compute_indices.end());
+        ++batch_count;
+        grouped_rotation_count += compute_indices.size();
+    }
+
+    for (NodeIndex compute_index : computes_to_erase) {
+        computes.erase(compute_index);
+    }
+
+    // Erasing compute nodes invalidates their addresses. Rebuild every edge
+    // from the surviving node definitions before scheduling begins.
+    for (auto& [data_index, data_node] : data) {
+        data_node.predecessors.clear();
+        data_node.successors.clear();
+    }
+    for (auto& [compute_index, compute_node] : computes) {
+        for (DatumNode* input_node : compute_node.input_nodes) {
+            input_node->successors.push_back(&compute_node);
+        }
+        for (DatumNode* output_node : compute_node.output_nodes) {
+            output_node->predecessors.push_back(&compute_node);
+        }
+    }
+
+    std::fprintf(stderr,
+                 "[GPU Rotation Hoisting] enabled=1 batches=%zu "
+                 "grouped_rotations=%zu removed_compute_nodes=%zu\n",
+                 batch_count, grouped_rotation_count, computes_to_erase.size());
+    std::fflush(stderr);
+}
