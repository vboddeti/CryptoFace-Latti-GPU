+        class RotationSuffixStreamPool
+        {
+          public:
+            ~RotationSuffixStreamPool()
+            {
+                for (cudaStream_t stream : streams_)
+                {
+                    cudaStreamSynchronize(stream);
+                    cudaStreamDestroy(stream);
+                }
+            }
+
+            void ensure_size(std::size_t count)
+            {
+                while (streams_.size() < count)
+                {
+                    cudaStream_t stream;
+                    HEONGPU_CUDA_CHECK(cudaStreamCreate(&stream));
+                    streams_.push_back(stream);
+                }
+            }
+
+            cudaStream_t operator[](std::size_t index) const
+            {
+                return streams_[index];
+            }
+
+          private:
+            std::vector<cudaStream_t> streams_;
+        };
+
+        thread_local RotationSuffixStreamPool rotation_suffix_stream_pool;
