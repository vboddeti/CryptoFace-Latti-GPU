+        /**
+         * Rotates one ciphertext by several direct Galois elements while
+         * sharing the method-II decomposition of the input. Outputs and
+         * shifts have a one-to-one correspondence and outputs must not alias
+         * the input or each other.
+         */
+        __host__ void rotate_rows_many(
+            Ciphertext<Scheme::CKKS>& input1,
+            const std::vector<Ciphertext<Scheme::CKKS>*>& outputs,
+            Galoiskey<Scheme::CKKS>& galois_key,
+            const std::vector<int>& shifts,
+            const ExecutionOptions& options = ExecutionOptions())
+        {
+            if (outputs.size() != shifts.size())
+            {
+                throw std::invalid_argument(
+                    "Rotation outputs and shifts must have the same size!");
+            }
+            if (outputs.empty())
+            {
+                return;
+            }
+            if (input1.relinearization_required_)
+            {
+                throw std::invalid_argument("Ciphertext can not be rotated!");
+            }
+
+            int current_decomp_count = context_->Q_size - input1.depth_;
+            if (input1.memory_size() < (2 * context_->n * current_decomp_count))
+            {
+                throw std::invalid_argument("Invalid Ciphertexts size!");
+            }
+            for (std::size_t i = 0; i < outputs.size(); ++i)
+            {
+                if (outputs[i] == nullptr || outputs[i] == &input1)
+                {
+                    throw std::invalid_argument(
+                        "Batched rotation outputs must be distinct objects!");
+                }
+                for (std::size_t j = 0; j < i; ++j)
+                {
+                    if (outputs[i] == outputs[j])
+                    {
+                        throw std::invalid_argument(
+                            "Batched rotation outputs must be distinct objects!");
+                    }
+                }
+            }
+
+            input_storage_manager(
+                input1,
+                [&](Ciphertext<Scheme::CKKS>& input1_)
+                {
+                    switch (static_cast<int>(galois_key.key_type))
+                    {
+                        case 2: // KEYSWITCHING_METHOD_II
+                            rotate_ckks_method_II_many(
+                                input1_, outputs, galois_key, shifts,
+                                options.stream_);
+                            break;
+                        default:
+                            // Method I is not used by the CryptoFace H200
+                            // context. Preserve correctness for other contexts
+                            // without claiming a hoisting benefit.
+                            for (std::size_t i = 0; i < outputs.size(); ++i)
+                            {
+                                rotate_ckks_method_I(input1_, *outputs[i],
+                                                     galois_key, shifts[i],
+                                                     options.stream_);
+                            }
+                            break;
+                    }
+                },
+                options, false);
+
+            for (auto* output : outputs)
+            {
+                if (options.storage_ == storage_type::DEVICE)
+                {
+                    output->store_in_device(options.stream_);
+                }
+                else if (options.storage_ == storage_type::HOST)
+                {
+                    output->store_in_host(options.stream_);
+                }
+                else
+                {
+                    throw std::invalid_argument("Invalid storage type!");
+                }
+            }
+        }
