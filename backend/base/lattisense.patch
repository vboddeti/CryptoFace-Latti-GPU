+    __host__ void HEOperator<Scheme::CKKS>::prepare_ringt_plaintext(
+        HEContext<Scheme::CKKS> context, Plaintext<Scheme::CKKS>& raw,
+        Plaintext<Scheme::CKKS>& result, cudaStream_t stream)
+    {
+        const int count = result.level() + 1;
+        if (!raw.is_ringt_ || result.is_ringt_ || count < 1 ||
+            count > context->Q_size || raw.size() != context->n ||
+            result.size() != context->n * count)
+            throw std::invalid_argument("Invalid RingT conversion cache operands");
+        ringt_to_pt_kernel<<<dim3((context->n >> 8), count, 1), 256, 0, stream>>>(
+            raw.data(), result.data(), context->modulus_->data(), context->n_power);
+        HEONGPU_CUDA_CHECK(cudaGetLastError());
+        gpuntt::ntt_rns_configuration<Data64> cfg = {
+            .n_power = context->n_power,
+            .ntt_type = gpuntt::FORWARD,
+            .ntt_layout = gpuntt::PerPolynomial,
+            .reduction_poly = gpuntt::ReductionPolynomial::X_N_plus,
+            .zero_padding = false,
+            .stream = stream};
+        gpuntt::GPU_NTT_Inplace(
+            result.data(), context->ntt_table_->data(), context->modulus_->data(),
+            cfg, count, count);
+        HEONGPU_CUDA_CHECK(cudaGetLastError());
+        result.scale_ = raw.scale_;
+        result.encoding_ = raw.encoding_;
+        result.in_ntt_domain_ = true;
+    }
+}
