+                CooleyTukeyUnitPublicTwiddle<Verify>(shared_memory[in_shared_address],
+                                shared_memory[in_shared_address + t],
+                                root_of_unity_table[current_root_index],
+                                modulus[prime_index], twiddle_quotients[current_root_index]);
+
+                t = t >> 1;
+                t_2 -= 1;
+                t_ -= 1;
+                m <<= 1;
+
+                in_shared_address =
+                    ((shared_addresss >> t_) << t_) + shared_addresss;
+                //__syncthreads();
+            }
+            __syncthreads();
